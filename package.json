{
  "name": "paperclip",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @paperclip/db migrate",
    "db:studio": "pnpm --filter @paperclip/db studio",
    "brief": "pnpm --filter @paperclip/stub-agents exec tsx ../../scripts/promote-brief.ts",
    "seed:x-creds": "pnpm --filter @paperclip/stub-agents exec tsx ../../scripts/seed-x-creds.ts"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.7.5"
  }
}
